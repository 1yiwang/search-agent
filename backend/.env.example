LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Search / fetch providers (see backend/providers/)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-key-here
# TAVILY_SEARCH_DEPTH=basic
FETCH_PROVIDER=chain
# JINA_API_KEY=              # optional, improves Jina Reader rate limits
# SEARCH_MAX_RESULTS=10
# FETCH_MAX_CHARS=8000
# EXTRACT_CONCURRENCY=3
# PLANNER_MAX_SECTIONS=5
# PLANNER_INITIAL_SOURCES=5
# DEEP_SOURCES_PER_QUERY=3
# Site + API auth (Mode B — personal deploy)
# SITE_PASSWORD=your-site-password
# API_AUTH_SECRET=long-random-string-shared-with-vercel
# API_TOKEN_TTL_SECONDS=86400
# CORS_ORIGINS=http://localhost:3000,https://search.yiwang.dev,https://search-agent-seven.vercel.app
# VERIFIER_SIMILARITY_THRESHOLD=0.75
# VERIFIER_MAX_REVISIONS=1
# MULTIHOP_MAX_HOPS=2
# MULTIHOP_SOURCES_PER_QUERY=3
# DACH narrow-domain seeds (Phase 1)
# RESEARCH_RECENCY_DAYS=90
# DACH_SEEDS_ENABLED=true
# DACH_MAX_SEED_QUERIES=5
# DACH_SEED_RESULTS_PER_QUERY=3

# Source Router + coverage loop (Wave 7)
# ROUTER_ENABLED=true
# ROUTER_MAX_SOURCES_PER_ROUND=6
# ROUTER_MAX_SITE_QUERIES=5
# ROUTER_MAX_DIRECT_FETCHES=4
# RESEARCH_MAX_HOPS=3
# RESEARCH_MAX_ROUTER_CALLS=4
# RESEARCH_COVERAGE_THRESHOLD=0.65
